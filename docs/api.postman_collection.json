{
  "info": {
    "name": "CRM Dientecitos Felices · API del asesor",
    "description": "Pruebas de la API (spec 02 en adelante). Antes de ejecutar: `php artisan migrate:fresh --seeder=VerificacionSeeder`, `npm run dev` en api/, y llenar las variables correo_valeria, correo_sergio, correo_ivan y clave con los datos de VerificacionSeeder. Ejecute la carpeta en orden: unas peticiones usan variables que guardan otras.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sesión",
      "description": "A1, A2 y la base de A7: inicio de sesión, middleware y errores en JSON.",
      "item": [
        {
          "name": "1. Login de Valeria → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Las variables correo_valeria y clave están llenas', () => {",
                  "  pm.expect(pm.collectionVariables.get('correo_valeria'), 'Llene correo_valeria').to.not.be.empty;",
                  "  pm.expect(pm.collectionVariables.get('clave'), 'Llene clave').to.not.be.empty;",
                  "});",
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Trae token y usuario { id, nombre, correo }', () => {",
                  "  pm.expect(cuerpo.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(Object.keys(cuerpo).sort()).to.eql(['token', 'usuario']);",
                  "  pm.expect(Object.keys(cuerpo.usuario).sort()).to.eql(['correo', 'id', 'nombre']);",
                  "});",
                  "pm.test('El token es HS256 y sub es el id en texto', () => {",
                  "  const decodificar = (parte) => JSON.parse(atob(parte.replace(/-/g, '+').replace(/_/g, '/')));",
                  "  const [cabecera, datos] = cuerpo.token.split('.');",
                  "  pm.expect(decodificar(cabecera).alg).to.eql('HS256');",
                  "  pm.expect(decodificar(datos).sub).to.eql(String(cuerpo.usuario.id));",
                  "});",
                  "",
                  "const internas = ['password', 'remember_token', 'rol', 'activo', 'vendedor_id', 'user_id', 'supervisor_id', 'usuario_id'];",
                  "pm.test('Sin llaves internas (password, rol, activo…)', () => {",
                  "  const texto = JSON.stringify(cuerpo);",
                  "  internas.forEach((llave) => pm.expect(texto).to.not.include('\"' + llave + '\"'));",
                  "});",
                  "pm.collectionVariables.set('token', cuerpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_valeria}}\",\n  \"clave\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "2. Valeria con clave incorrecta → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje: Correo o contraseña incorrectos.', () => pm.expect(pm.response.json()).to.eql({ error: 'Correo o contraseña incorrectos.' }));",
                  "",
                  "pm.test('No trae token', () => pm.expect(pm.response.json()).to.not.have.property('token'));",
                  "pm.collectionVariables.set('cuerpo_401', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_valeria}}\",\n  \"clave\": \"{{clave}}-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "3. Correo inexistente → 401 idéntico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje: Correo o contraseña incorrectos.', () => pm.expect(pm.response.json()).to.eql({ error: 'Correo o contraseña incorrectos.' }));",
                  "pm.test('Cuerpo idéntico byte por byte al de la petición 2', () => {",
                  "  const anterior = pm.collectionVariables.get('cuerpo_401');",
                  "  pm.expect(anterior, 'Ejecute antes la petición 2').to.not.be.empty;",
                  "  pm.expect(pm.response.text()).to.eql(anterior);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"nadie@no-existe.invalid\",\n  \"clave\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base}}/auth/login"
          }
        },
