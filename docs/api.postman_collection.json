              }
            },
            "url": "{{base}}/auth/login"
          }
        },
        {
          "name": "8. GET /yo con token → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Trae exactamente id, nombre y correo', () => {",
                  "  pm.expect(Object.keys(cuerpo).sort()).to.eql(['correo', 'id', 'nombre']);",
                  "  pm.expect(cuerpo.id).to.be.a('number');",
                  "});",
                  "",
                  "const internas = ['password', 'remember_token', 'rol', 'activo', 'vendedor_id', 'user_id', 'supervisor_id', 'usuario_id'];",
                  "pm.test('Sin llaves internas (password, rol, activo…)', () => {",
                  "  const texto = JSON.stringify(cuerpo);",
                  "  internas.forEach((llave) => pm.expect(texto).to.not.include('\"' + llave + '\"'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base}}/yo"
          }
        },
        {
          "name": "9. GET /yo sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje: Falta el token de acceso.', () => pm.expect(pm.response.json()).to.eql({ error: 'Falta el token de acceso.' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/yo"
          }
        },
        {
          "name": "10. GET /yo con el token alterado → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cambia un carácter en medio de la firma (no el último, que puede tener bits de relleno).",
                  "const token = pm.collectionVariables.get('token') || '';",
                  "const i = token.length - 10;",
                  "const nuevo = token[i] === 'A' ? 'B' : 'A';",
                  "pm.collectionVariables.set('token_alterado', token.slice(0, i) + nuevo + token.slice(i + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje: El token no es válido o ya venció.', () => pm.expect(pm.response.json()).to.eql({ error: 'El token no es válido o ya venció.' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_alterado}}"
              }
            ],
            "url": "{{base}}/yo"
          }
        },
